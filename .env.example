# Painel KAVRIA v2 (multicanal via Jodda AI). Copie para .env e preencha. NUNCA commitar o .env.
# Chave da API da Jodda (Integrações → Extensão e API → API da Jodda). Só leitura.
JODDA_API_KEY=
BACKFILL_FROM=2026-11-01
# No servidor (docker-compose) é montada a partir do DOMAIN.
PUBLIC_BASE_URL=https://painel2.SEU-DOMINIO
APP_SECRET=
ADMIN_PASSWORD=
TV_ACCESS_KEY=
WORKERS_ENABLED=true
DATABASE_URL=sqlite+aiosqlite:///./data/kavria2.db
